# Repository-root .env for Node scripts and the Discord bot.
# Local website + admin dev (`pnpm dev`) needs NO .env file (uses local Wrangler R2 + dev auth).
# Never commit .env, and never prefix secrets with PUBLIC_ or VITE_.

# ---------------------------------------------------------------------------
# 1. Cloudflare R2 S3 API credentials
# Required for: Discord bot (`pnpm dev:bot`)
# Optional for: `pnpm gallery:migrate`, `pnpm images:migrate`, `pnpm pages:seed`
#               (omit to use `wrangler` OAuth instead)
# ---------------------------------------------------------------------------
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
# Account-level S3 endpoint only — do NOT include the bucket name (/mmb-media):
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# 2. Discord gallery upload bot (optional)
# Omit both to leave the bot in standby during `pnpm dev`.
# Also requires the R2 S3 credentials above. Enable "Message Content Intent"
# in the Discord Developer Portal before running.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Numeric channel ID (DISCORD_UPLOAD_CHANNEL_ID is also accepted):
DISCORD_UPLOAD_CHANNEL=

# ---------------------------------------------------------------------------
# 3. Cloudflare control-plane credentials (optional)
# `wrangler login` handles Pages builds and deploys. Provide a scoped API token
# only when automating Zero Trust Access or DNS (`pnpm cloudflare:setup` / `cloudflare:access`).
# ---------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Where other environment variables live:
# - apps/admin-dashboard/.dev.vars.example -> Worker/Pages secrets (Access, GitHub history, Google Drive)
# - apps/website/.env.example              -> Optional public API URL override for Astro
# ---------------------------------------------------------------------------
