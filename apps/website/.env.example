# Optional public API origin used by the Astro frontend during development.
# Covers /api/gallery, /api/content, /media/*, and /files/*.
# Never place R2 credentials or admin secrets here.

# Local development (defaults to http://127.0.0.1:8787 in dev mode if unset):
PUBLIC_GALLERY_API_URL=http://127.0.0.1:8787

# Production (defaults to https://mmb.nickly.me if unset):
# PUBLIC_GALLERY_API_URL=https://mmb.nickly.me
