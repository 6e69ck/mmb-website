---
import site from '../data/prepared-site.json';
import images from '../data/images.json';
import Navigation from '../components/Navigation';
import ImageExperience from '../components/ImageExperience';
import FormExperience from '../components/FormExperience';
import Gallery, { type MediaItem } from '../components/Gallery';
import Footer from '../components/Footer.astro';
import galleryData from '../data/gallery.json';
import responsiveCss from '../styles/responsive.css?inline';
import galleryCss from '../styles/gallery.css?inline';
import footerCss from '../styles/footer.css?inline';
import joinGridCss from '../styles/join-grid.css?inline';
import teamCss from '../styles/team-sections.css?inline';
import touchNavigationCss from '../styles/navigation-touch.css?inline';
import faqCss from '../styles/faq-buttons.css?inline';
const { page } = Astro.props;
const logo = images[site.logo as keyof typeof images];
const isGallery = ['/gallery.html', '/media.html', '/videos.html'].includes(page.path) || /^\/mmbs-\d{4}\.html$/.test(page.path);
const initialType = page.path === '/videos.html' ? 'videos' : 'all';
const preferredYear = /^\/mmbs-\d{4}\.html$/.test(page.path) ? Number(page.path.match(/\d{4}/)?.[0]) : undefined;
const initialYear = initialType === 'videos' ? galleryData.videoYears[0] : preferredYear || galleryData.years[0];
const galleryApiBase = import.meta.env.PUBLIC_GALLERY_API_URL || (import.meta.env.DEV ? 'http://127.0.0.1:8787' : 'https://mmb.nickly.me');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    <title>{page.title}</title>
    <link rel="icon" type="image/png" href={site.logo} />
    <link rel="canonical" href={new URL(page.path, Astro.site || site.origin)} />
    <script is:inline>
      document.addEventListener('load', (event) => {
        if (event.target instanceof HTMLImageElement) event.target.dataset.imageReady = 'true';
      }, true);
    </script>
    {page.stylesheets.map((href: string) => <link rel="stylesheet" href={href} />)}
    {page.inlineStyles.map((css: string) => <style is:inline set:html={css} />)}
    <style is:inline set:html={responsiveCss} />
    <style is:inline set:html={galleryCss} />
    <style is:inline set:html={footerCss} />
    <style is:inline set:html={joinGridCss} />
    <style is:inline set:html={teamCss} />
    <style is:inline set:html={touchNavigationCss} />
    <style is:inline set:html={faqCss} />
  </head>
  <body class={page.bodyClass}>
    <Navigation items={site.navigation} current={page.path} logo={site.logo} width={logo.width} height={logo.height} client:load />
    <main id="main-content" tabindex="-1" class="main-wrap">
      <Fragment set:html={page.bannerHtml} />
      {isGallery ? <div id="wsite-content" class="wsite-elements wsite-not-footer"><Gallery years={galleryData.years} photoYears={galleryData.photoYears} videoYears={galleryData.videoYears} initialYear={initialYear} initialType={initialType} initialItems={galleryData.albums[String(initialYear) as keyof typeof galleryData.albums] as MediaItem[]} preferredYear={preferredYear} apiBase={galleryApiBase} client:load /></div> : <div id="wsite-content" class="wsite-elements wsite-not-footer" set:html={page.contentHtml} />}
    </main>
    <Footer />
    <ImageExperience client:load />
    {page.contentHtml.includes('<form') && <FormExperience client:load />}
  </body>
</html>
